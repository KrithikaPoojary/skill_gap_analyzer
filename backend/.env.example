# Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and populate it before starting the server.
# NEVER commit .env to Git — it is excluded via .gitignore.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your actual values
# ─────────────────────────────────────────────────────────────────────────────

# Application Runtime
APP_NAME="Job Market Intelligence & Skill Gap Analyzer"
APP_VERSION="0.1.0"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1

# CORS — space-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
# For development: SQLite (default, no setup required)
# For production: replace with PostgreSQL DSN
DATABASE_URL=sqlite:///./skill_gap_analyzer.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skill_gap_analyzer

# File Uploads
MAX_UPLOAD_SIZE_BYTES=5242880    # 5 MB
UPLOAD_DIRECTORY=uploads

# Authentication & Security
JWT_SECRET_KEY=super-secret-dev-jwt-key-for-skill-gap-analyzer-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

